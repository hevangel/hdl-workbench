{
  "name": "xezim-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @xezim-ide/mcp-bridge test:e2e",
