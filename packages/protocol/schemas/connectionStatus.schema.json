{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "xezim-ide/1"
    },
    "connected": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "browser_simulation",
              "waveform_load",
              "waveform_add_signals",
              "waveform_cursor"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "name",
          "available"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol",
    "connected",
    "capabilities"
  ],
  "additionalProperties": false
}
