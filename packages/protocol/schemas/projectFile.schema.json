{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*[\\\\\\u0000-\\u001f\\u007f])[^/]+(?:\\/[^/]+)*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contentBase64": {
      "type": "string",
      "maxLength": 22369624,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "required": [
    "path",
    "revision",
    "contentBase64"
  ],
  "additionalProperties": false
}
