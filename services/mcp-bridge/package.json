{
  "name": "@xezim-ide/mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run test",
    "test:e2e": "pnpm build && playwright test --config=playwright.config.mjs",
    "test:inspector": "pnpm build && vitest run test/bridge.integration.test.ts -t 'official MCP Inspector CLI'"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@xezim-ide/protocol": "workspace:*",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/inspector": "2.12.0",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
